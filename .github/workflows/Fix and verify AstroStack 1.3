name: Fix and verify AstroStack 1.3

on:
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/fix-astrostack-1.3.yml'

permissions:
  contents: write

jobs:
  verify:
    runs-on: windows-latest
    timeout-minutes: 60

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Correggi AstroStack 1.3
        shell: powershell
        run: |
          @'
          from pathlib import Path

          root = Path("source")

          ux = root / "app/astrostack/gui/ux_v13.py"
          main = root / "app/main.py"
          setup = root / "setup/install_offline.ps1"
          version = root / "app/astrostack/__init__.py"

          # ------------------------------------------------------
          # 1. Ripara i caratteri UTF-8 della nuova UI
          # ------------------------------------------------------

          text = ux.read_text(encoding="utf-8-sig")

          if any(x in text for x in ("Ã", "â", "Â")):
              text = text.encode("cp1252").decode("utf-8")

          ux.write_text(
              text,
              encoding="utf-8",
          )

          # ------------------------------------------------------
          # 2. Versione corretta nell'installer
          # ------------------------------------------------------

          text = setup.read_text(
              encoding="utf-8-sig"
          )

          text = text.replace(
              "$Version = '1.2.0-preview-offline'",
              "$Version = '1.3.0-preview-offline'",
          )

          text = text.replace(
              'Text="AstroStack 1.2.0 Preview"',
              'Text="AstroStack 1.3.0 Preview"',
          )

          setup.write_text(
              text,
              encoding="utf-8",
          )

          # ------------------------------------------------------
          # 3. Apertura automatica file .astrostack
          # ------------------------------------------------------

          text = main.read_text(
              encoding="utf-8-sig"
          )

          if "startup_project = None" not in text:

              old = (
                  "    win = MainWindow()\n"
                  "    install_ux_v13(win)\n"
                  "    win.setWindowOpacity(0.0)\n"
              )

              new = (
                  "    win = MainWindow()\n"
                  "    install_ux_v13(win)\n"
                  "\n"
                  "    startup_project = None\n"
                  "    if len(sys.argv) > 1:\n"
                  "        candidate = os.path.abspath(sys.argv[1])\n"
                  "        if candidate.lower().endswith('.astrostack') and os.path.isfile(candidate):\n"
                  "            startup_project = candidate\n"
                  "\n"
                  "    win.setWindowOpacity(0.0)\n"
              )

              if old not in text:
                  raise RuntimeError(
                      "Punto MainWindow non trovato"
                  )

              text = text.replace(
                  old,
                  new,
                  1,
              )

          text = text.replace(
              "    from PySide6.QtCore import QEasingCurve, QPropertyAnimation\n",
              "    from PySide6.QtCore import QEasingCurve, QPropertyAnimation, QTimer\n",
          )

          if (
              "win.open_project(path=p)"
              not in text
          ):

              old = "    return app.exec()\n"

              new = (
                  "    if startup_project:\n"
                  "        QTimer.singleShot(\n"
                  "            0,\n"
                  "            lambda p=startup_project: win.open_project(path=p),\n"
                  "        )\n"
                  "\n"
                  "    return app.exec()\n"
              )

              if old not in text:
                  raise RuntimeError(
                      "return app.exec non trovato"
                  )

              text = text.replace(
                  old,
                  new,
                  1,
              )

          main.write_text(
              text,
              encoding="utf-8",
          )

          # ------------------------------------------------------
          # 4. Versione applicazione
          # ------------------------------------------------------

          version.write_text(
              '"""AstroStack."""\n'
              '__version__ = "1.3.0-preview"\n',
              encoding="utf-8",
          )

          # ------------------------------------------------------
          # 5. Verifiche automatiche
          # ------------------------------------------------------

          ux_text = ux.read_text(
              encoding="utf-8"
          )

          assert "Modalità" in ux_text
          assert "Più contrasto" in ux_text
          assert "Nuovo stack" in ux_text
          assert "Esporta…" in ux_text

          assert "Ã" not in ux_text
          assert "â" not in ux_text

          setup_text = setup.read_text(
              encoding="utf-8"
          )

          assert "AstroStack 1.3.0 Preview" in setup_text
          assert "1.3.0-preview-offline" in setup_text

          main_text = main.read_text(
              encoding="utf-8"
          )

          assert "startup_project = None" in main_text
          assert "win.open_project(path=p)" in main_text

          print("FIX_ASTROSTACK_1_3_OK")

          '@ | Set-Content `
            -Path ".\fix_v13.py" `
            -Encoding UTF8

          python ".\fix_v13.py"

      - name: Controllo sintassi Python
        shell: powershell
        run: |
          python -m py_compile `
            ".\source\app\main.py" `
            ".\source\app\astrostack\__init__.py" `
            ".\source\app\astrostack\gui\main_window.py" `
            ".\source\app\astrostack\gui\ux_v13.py"

      - name: Installa dipendenze test
        shell: powershell
        run: |
          python -m pip install `
            --disable-pip-version-check `
            -r ".\source\app\requirements.txt"

      - name: Smoke test reale GUI
        shell: powershell
        env:
          QT_QPA_PLATFORM: offscreen
        run: |
          @'
          import os
          import sys
          import tempfile

          sys.path.insert(
              0,
              os.path.abspath("source/app"),
          )

          from PySide6.QtWidgets import QApplication

          from astrostack.gui.main_window import MainWindow
          from astrostack.gui.ux_v13 import install
          from astrostack.core import project as project_io
          from astrostack.core.pipeline import Settings


          app = QApplication([])

          win = MainWindow()

          install(win)

          # Home
          assert hasattr(
              win,
              "home_panel",
          )

          # Modalità semplice/avanzata
          assert hasattr(
              win,
              "btn_ui_mode",
          )

          # Editor standalone
          assert hasattr(
              win,
              "editor_sidebar",
          )

          win._set_workspace(
              "editor"
          )

          assert (
              win.workspace
              == "editor"
          )

          win._set_workspace(
              "stack"
          )

          assert (
              win.workspace
              == "stack"
          )

          # Preset Galassia
          win._apply_editor_preset(
              "galaxy"
          )

          params = (
              win.develop_panel.params()
          )

          assert abs(
              params.contrast - 18.0
          ) < 0.01

          assert abs(
              params.star_reduce - 8.0
          ) < 0.01

          # Progetto .astrostack
          with tempfile.TemporaryDirectory() as td:

              project = os.path.join(
                  td,
                  "test.astrostack",
              )

              project_io.save_project(
                  project,
                  {
                      "light": [],
                      "dark": [],
                      "flat": [],
                      "bias": [],
                  },
                  Settings().__dict__,
                  [],
                  None,
                  True,
                  None,
                  [],
                  {
                      "workspace": "stack",
                      "ui_mode": "simple",
                  },
              )

              win.open_project(
                  path=project
              )

              assert (
                  win.project_path
                  == project
              )

          print(
              "ASTROSTACK_GUI_SMOKE_TEST_OK"
          )

          win.close()

          app.processEvents()

          '@ | python -

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.23.x'

      - name: Prepara Go
        shell: powershell
        run: |
          Push-Location ".\source\launcher"

          if (-not (Test-Path "go.mod")) {
            go mod init astrostack-launcher
          }

          Pop-Location

          Push-Location ".\source\setup"

          if (-not (Test-Path "go.mod")) {
            go mod init astrostack-setup
          }

          Pop-Location

      - name: Build installer offline verificato
        shell: powershell
        run: |
          Set-Location ".\source"

          .\build_offline.ps1 `
            -Version "1.3.0_preview"

      - name: Salva correzioni 1.3
        shell: powershell
        run: |
          git config `
            user.name `
            "github-actions[bot]"

          git config `
            user.email `
            "41898282+github-actions[bot]@users.noreply.github.com"

          git add `
            source/app/main.py `
            source/app/astrostack/__init__.py `
            source/app/astrostack/gui/ux_v13.py `
            source/setup/install_offline.ps1

          $changes = git status --porcelain

          if ($changes) {

            git commit `
              -m "Fix and verify AstroStack 1.3"

            git push
          }

      - name: Upload installer verificato
        uses: actions/upload-artifact@v4
        with:
          name: AstroStack-1.3.0-preview-verified-offline-windows
          path: |
            source/AstroStack_Setup_Offline_1.3.0_preview.exe
            source/AstroStack_Setup_Offline_1.3.0_preview.exe.sha256.txt
          if-no-files-found: error
          compression-level: 0
